# Copy this file to `.env.local` for local development.
# Never commit `.env.local` or replace these placeholders with real secrets here.
# For Vercel, add the same variables in Project Settings → Environment Variables.

# ================================================================
# SPOTIFY
# ================================================================
# Used by the server to display current/last-played Spotify activity.
# Get the client ID and secret from:
# https://developer.spotify.com/dashboard
#
# In Spotify Dashboard → Your App → Settings, add this redirect URI:
# Local:      http://localhost:3000/api/spotify/admin/callback
# Production: https://YOUR-DOMAIN.com/api/spotify/admin/callback
#
# SPOTIFY_REFRESH_TOKEN is generated through the private setup flow at:
# http://localhost:3000/admin/spotify
# or https://YOUR-DOMAIN.com/admin/spotify
# On Vercel, add the refresh token directly as an environment variable because
# Vercel's filesystem is read-only and cannot persist `.env.local`.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REFRESH_TOKEN=your-spotify-refresh-token
# Generate a separate long random value. This protects the private setup page.
SPOTIFY_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# ================================================================
# CONTACT FORM / RESEND
# ================================================================
# Create an account and API key at:
# https://resend.com/api-keys
# CONTACT_FROM_EMAIL must use a verified Resend domain in production.
RESEND_API_KEY=re_your-resend-api-key
CONTACT_TO_EMAIL=your-inbox@example.com
CONTACT_FROM_EMAIL=Portfolio <hello@example.com>

# ================================================================
# DESKTOP PRESENCE COMPANION
# ================================================================
# The companion runs on your Windows computer and sends activity to this URL.
# Local development:
PRESENCE_URL=http://localhost:3000/api/presence/publish
# Production example:
# PRESENCE_URL=https://YOUR-DOMAIN.com/api/presence/publish
#
# This must match the value configured on Vercel for PRESENCE_PUBLISH_TOKEN.
# Generate one with PowerShell:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
PRESENCE_PUBLISH_TOKEN=replace-with-a-long-random-presence-token
PRESENCE_INTERVAL_MS=15000

# ================================================================
# UPSTASH REDIS
# ================================================================
# Recommended for production Vercel deployments because serverless instances
# do not share in-memory state.
# Create a database at https://console.upstash.com/
# Open the database → Connect → REST API, then copy these two values.
# These values belong on the Vercel server and should not be placed in the
# desktop companion's environment unless you explicitly need direct access.
KV_REST_API_URL=https://your-database-url.upstash.io
KV_REST_API_TOKEN=your-upstash-rest-token

# ================================================================
# REQUIRED BY CONTEXT
# ================================================================
# No NEXT_PUBLIC_* variables are currently required by this application.
# Keep all variables above server-side; do not expose secrets to the browser.
